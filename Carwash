<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AAA Lmt - Carwash On Spot</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
scroll-behavior:smooth;
}

body{
background:#f8f9fb;
color:#111;
overflow-x:hidden;
}

header{
height:100vh;
background:
linear-gradient(rgba(255,255,255,0.75),rgba(255,255,255,0.75)),
url('https://images.unsplash.com/photo-1503376780353-7e6692767b70?q=80&w=1920');
background-size:cover;
background-position:center;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
padding:20px;
position:relative;
}

header::before{
content:'';
position:absolute;
width:300px;
height:300px;
background:rgba(0,174,255,0.15);
border-radius:50%;
filter:blur(80px);
animation:float 6s ease-in-out infinite;
}

@keyframes float{
0%{transform:translateY(0px);}
50%{transform:translateY(-30px);}
100%{transform:translateY(0px);}
}

.hero{
position:relative;
z-index:2;
max-width:800px;
}

.hero h1{
font-size:70px;
font-weight:700;
color:#111;
}

.hero h2{
font-size:28px;
margin-top:10px;
color:#00aaff;
font-weight:500;
}

.hero p{
margin-top:20px;
font-size:18px;
line-height:1.7;
color:#444;
}

.btn{
display:inline-block;
margin-top:35px;
padding:16px 40px;
background:#00aaff;
color:white;
text-decoration:none;
border-radius:50px;
font-weight:600;
font-size:18px;
transition:0.3s;
box-shadow:0 10px 30px rgba(0,174,255,0.3);
}

.btn:hover{
transform:translateY(-5px);
background:#0091d9;
}

section{
padding:90px 10%;
}

.title{
text-align:center;
margin-bottom:60px;
}

.title h2{
font-size:42px;
margin-bottom:10px;
}

.title p{
color:#666;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:30px;
}

.card{
background:white;
padding:40px 30px;
border-radius:25px;
box-shadow:0 10px 30px rgba(0,0,0,0.06);
transition:0.4s;
position:relative;
overflow:hidden;
}

.card::before{
content:'';
position:absolute;
width:120px;
height:120px;
background:rgba(0,174,255,0.08);
border-radius:50%;
top:-40px;
right:-40px;
}

.card:hover{
transform:translateY(-10px);
}

.card h3{
font-size:26px;
margin-bottom:15px;
}

.card p{
color:#666;
line-height:1.7;
}

.price{
font-size:34px;
font-weight:700;
margin:20px 0;
color:#00aaff;
}

.features{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:30px;
}

.feature{
background:white;
padding:35px;
border-radius:20px;
box-shadow:0 10px 30px rgba(0,0,0,0.05);
transition:0.3s;
}

.feature:hover{
transform:scale(1.03);
}

.feature h3{
margin-bottom:15px;
font-size:22px;
}

.booking{
background:white;
border-radius:30px;
padding:50px;
box-shadow:0 10px 40px rgba(0,0,0,0.07);
max-width:700px;
margin:auto;
}

.booking form{
display:flex;
flex-direction:column;
gap:20px;
}

.booking input,
.booking select{
padding:16px;
border:none;
background:#f3f5f8;
border-radius:14px;
font-size:16px;
outline:none;
}

.booking button{
padding:18px;
border:none;
background:#00aaff;
color:white;
font-size:18px;
font-weight:600;
border-radius:14px;
cursor:pointer;
transition:0.3s;
}

.booking button:hover{
background:#008ed3;
}

footer{
background:#111;
color:white;
padding:50px 20px;
text-align:center;
margin-top:80px;
}

.whatsapp{
position:fixed;
bottom:25px;
right:25px;
width:70px;
height:70px;
background:#25D366;
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
font-size:34px;
color:white;
text-decoration:none;
box-shadow:0 10px 30px rgba(37,211,102,0.4);
z-index:999;
animation:pulse 2s infinite;
}

@keyframes pulse{
0%{
transform:scale(1);
}
50%{
transform:scale(1.08);
}
100%{
transform:scale(1);
}
}

.fade{
opacity:0;
transform:translateY(40px);
transition:1s;
}

.fade.active{
opacity:1;
transform:translateY(0);
}

@media(max-width:768px){

.hero h1{
font-size:45px;
}

.hero h2{
font-size:22px;
}

section{
padding:70px 6%;
}

.booking{
padding:30px;
}

}

</style>
</head>

<body>

<header>

<div class="hero fade">

<h1>AAA Lmt</h1>
<h2>Carwash On Spot</h2>

<p>
Professional mobile carwash service all over Malta.
We come directly to your location on time with premium cleaning products and shine finish.
</p>

<a class="btn" href="https://wa.me/35699941737?text=Hello%20AAA%20Lmt,%20I%20want%20book%20carwash">
Book On WhatsApp
</a>

</div>

</header>

<section>

<div class="title fade">
<h2>Our Services</h2>
<p>Premium cleaning with professional shine effects</p>
</div>

<div class="cards">

<div class="card fade">
<h3>Outside Wash</h3>
<div class="price">€40</div>
<p>
Professional exterior foam wash, wheels cleaning, windows and premium shine finish.
</p>
</div>

<div class="card fade">
<h3>Inside + Outside</h3>
<div class="price">€50</div>
<p>
Complete deep cleaning inside and outside including vacuum and interior wipe.
</p>
</div>

<div class="card fade">
<h3>Premium Detail</h3>
<div class="price">Custom</div>
<p>
Extra detailing service available depending on vehicle condition and request.
</p>
</div>

</div>

</section>

<section>

<div class="title fade">
<h2>Why Choose Us</h2>
<p>Fast, modern and professional mobile carwash</p>
</div>

<div class="features">

<div class="feature fade">
<h3>We Come To You</h3>
<p>
Home, work or parking area — we wash your car directly on spot anywhere in Malta.
</p>
</div>

<div class="feature fade">
<h3>Always On Time</h3>
<p>
Fast booking and professional service with scheduled arrival time.
</p>
</div>

<div class="feature fade">
<h3>Premium Products</h3>
<p>
High quality cleaning materials for deep shine and safe vehicle care.
</p>
</div>

<div class="feature fade">
<h3>Cash Or SumUp</h3>
<p>
Easy payments available by cash or SumUp machine.
</p>
</div>

</div>

</section>

<section>

<div class="title fade">
<h2>Book Your Carwash</h2>
<p>Send your booking directly to WhatsApp</p>
</div>

<div class="booking fade">

<form id="bookingForm">

<input type="text" id="name" placeholder="Your Name" required>

<select id="service">
<option>Outside Wash €40</option>
<option>Inside + Outside €50</option>
<option>Premium Detail</option>
</select>

<input type="text" id="location" placeholder="Your Location" required>

<input type="time" id="time" required>

<button type="submit">
Book Now
</button>

</form>

</div>

</section>

<footer>

<h2>AAA Lmt</h2>
<p>Carwash On Spot - All Over Malta</p>
<p style="margin-top:15px;">
WhatsApp: +356 9994 1737
</p>

</footer>

<a class="whatsapp"
href="https://wa.me/35699941737?text=Hello%20AAA%20Lmt,%20I%20want%20book%20carwash">
✆
</a>

<script>

const fades = document.querySelectorAll('.fade');

window.addEventListener('scroll', () => {

fades.forEach(fade => {

const top = fade.getBoundingClientRect().top;

if(top < window.innerHeight - 100){
fade.classList.add('active');
}

});

});

document.getElementById('bookingForm').addEventListener('submit', function(e){

e.preventDefault();

let name = document.getElementById('name').value;
let service = document.getElementById('service').value;
let location = document.getElementById('location').value;
let time = document.getElementById('time').value;

let message =
`Hello AAA Lmt,
I want book carwash.

Name: ${name}
Service: ${service}
Location: ${location}
Time: ${time}`;

let url = `https://wa.me/35699941737?text=${encodeURIComponent(message)}`;

window.open(url, '_blank');

});

</script>

</body>
</html>
